{
  "project": "FOOTBALLER QUEST - Pokelike Overworld Redesign",
  "app_type": "mobile_web_app_game",
  "target_viewport": "max-width: 448px, mobile-first column",
  "style_theme": "Retro GBA / Pixel Art Pokelike Slay-the-Spire Style",
  "fonts": {
    "heading": "'Press Start 2P', monospace",
    "body": "'VT323', monospace",
    "ui_sans": "system-ui, sans-serif"
  },
  "act_palettes": {
    "act1_raimon_tokyo": {
      "name": "Act I - Raimon / Tokyo Town",
      "ground": "#1a2e26",
      "accent": "#f1d48c",
      "sky": "#2d4a3e",
      "path_color": "#d9ab7d",
      "path_done": "#ffe5a0",
      "bg_css": "linear-gradient(180deg, #10221c 0%, #1a2e26 50%, #14241d 100%)",
      "pattern": "repeating-linear-gradient(0deg, #10221c 0 24px, #1a2e26 25px 48px)"
    },
    "act2_frontier_stadium": {
      "name": "Act II - Football Frontier Stadium",
      "ground": "#1d2a44",
      "accent": "#50b5ff",
      "sky": "#0f172a",
      "path_color": "#7dd3fc",
      "path_done": "#38bdf8",
      "bg_css": "linear-gradient(180deg, #0f172a 0%, #1d2a44 60%, #131d30 100%)",
      "pattern": "repeating-linear-gradient(90deg, #0f172a 0 20px, #1d2a44 21px 40px)"
    },
    "act3_alius_invasion": {
      "name": "Act III - Alius Invasion (Nara/Osaka/Hokkaido)",
      "ground": "#2a1e36",
      "accent": "#d8b4fe",
      "sky": "#180f24",
      "path_color": "#c084fc",
      "path_done": "#f0abfc",
      "bg_css": "linear-gradient(180deg, #180f24 0%, #2a1e36 50%, #20142d 100%)",
      "pattern": "radial-gradient(#c084fc22 1px, transparent 2px)"
    },
    "act4_alius_showdown": {
      "name": "Act IV - Alius Showdown Dark",
      "ground": "#1f1520",
      "accent": "#ff4655",
      "sky": "#0b060c",
      "path_color": "#f43f5e",
      "path_done": "#fb7185",
      "bg_css": "linear-gradient(180deg, #0b060c 0%, #1f1520 70%, #120913 100%)",
      "pattern": "repeating-linear-gradient(135deg, #1f1520 0 10px, #0b060c 11px 20px)"
    },
    "act5_ffi_island": {
      "name": "Act V - FFI International Island",
      "ground": "#1b3338",
      "accent": "#2dd4bf",
      "sky": "#081c24",
      "path_color": "#2dd4bf",
      "path_done": "#99f6e4",
      "bg_css": "linear-gradient(180deg, #081c24 0%, #1b3338 50%, #0d2229 100%)",
      "pattern": "repeating-linear-gradient(0deg, #081c24 0 16px, #1b3338 17px 32px)"
    }
  },
  "hud_layout": {
    "top_bar": {
      "bg": "#0f1b18",
      "border": "2px solid #3d5849",
      "team_bar": {
        "max_members": 6,
        "portrait_size": "28px",
        "hp_bar_height": "4px",
        "hp_fill_color": "#22c55e",
        "hp_low_color": "#ef4444"
      },
      "money_badge": {
        "text_color": "#ffe5a1",
        "font": "'Press Start 2P', monospace",
        "font_size": "11px"
      }
    },
    "traits_strip": {
      "bg": "#162823",
      "border_bottom": "1px solid #2d453b",
      "badge_style": "background: #233e36; border: 1px solid #4a6d5f; font-size: 11px; padding: 2px 6px; border-radius: 3px; color: #b8e6d2;"
    }
  },
  "node_styles": {
    "grid_columns": 3,
    "sizes": {
      "standard": "48px",
      "boss": "72px",
      "portrait_node": "52px"
    },
    "states": {
      "completed": {
        "border": "2px solid #4ade80",
        "bg": "#143828",
        "opacity": 0.75,
        "badge": "Check icon"
      },
      "available": {
        "border": "3px solid #ffe5a1",
        "bg": "#314f44",
        "animation": "ow-node-pulse 1.8s infinite ease-in-out",
        "box_shadow": "0 0 12px rgba(255, 229, 161, 0.4)",
        "cursor": "pointer"
      },
      "locked": {
        "border": "2px dashed #4b5563",
        "bg": "#182220",
        "opacity": 0.5,
        "icon": "Lock"
      },
      "current": {
        "border": "3px double #f59e0b",
        "bg": "#2e483f"
      }
    },
    "special_nodes": {
      "rival_encounter": {
        "border": "3px solid #ef4444",
        "box_shadow": "0 0 10px rgba(239, 68, 68, 0.6)",
        "badge": "RIVALE (red pulsing ring)"
      },
      "temporal_anomaly": {
        "border": "2px solid #c084fc",
        "bg": "linear-gradient(135deg, #2e1065, #06b6d4)",
        "animation": "glitch-pulse 1.2s infinite alternate",
        "badge": "ANOMALIA (glitchy purple/cyan rift)"
      },
      "boss": {
        "shape": "Crest / Shield frame",
        "border": "3px solid #f59e0b",
        "bg": "#3b2314",
        "icon": "Trophy or Large Crest frame"
      }
    }
  },
  "path_styles": {
    "type": "SVG connecting lines",
    "stroke_width": "4px",
    "stroke_dasharray": "4, 6",
    "line_cap": "round",
    "done_stroke": "solid 4px #ffe5a1"
  },
  "node_preview_sheet": {
    "overlay_bg": "rgba(5, 15, 12, 0.82)",
    "modal_bg": "#182e28",
    "modal_border": "3px solid #f1d48c",
    "box_shadow": "6px 6px 0px #091411",
    "title_font": "'Press Start 2P', monospace",
    "title_color": "#ffe5a1",
    "cta_button": {
      "bg": "#f1d48c",
      "text_color": "#0f1f1a",
      "border_bottom": "4px solid #b89343",
      "font_size": "16px",
      "font_weight": "bold"
    }
  },
  "instructions_to_main_agent": [
    "1. Redesign OverworldMap.jsx to display a vertical Pokelike-style node map with 3 lanes.",
    "2. Each row corresponds to a wave step, containing 2-3 nodes connected by dotted SVG paths.",
    "3. Implement top HUD containing team portraits with mini HP bars, money counter, and synergy traits strip.",
    "4. Apply act-specific color palettes and CSS background patterns dynamically according to the current act.",
    "5. Style special nodes: Rival (red glow ring), Temporal Anomaly (purple/cyan rift glitch), Boss (large crest).",
    "6. Ensure node preview bottom/dialog sheet has clear risk description, route details, and a high-contrast 'Entra' CTA.",
    "7. Include data-testid attributes on all nodes, HUD elements, traits, and modal actions for test verification."
  ]
}